{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northwind-with-apimatic",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "vars": {
    // Which PayPal environment PAYPAL_CLIENT_ID/SECRET and PAYPAL_API_BASE belong to: "sandbox" or "live".
    // Decides the PayPal approval host buyers are sent to. The credentials and gateway URL are secrets.
    "PAYPAL_ENV": "sandbox",
  },
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northwind-with-apimatic",
      // Placeholder: local development and tests only. Replace with the real
      // database_id (from `wrangler d1 create northwind-coffee`) before deploying.
      "database_id": "058d69cc-e61f-4156-8330-e059150fca8e",
      "migrations_dir": "migrations",
    },
  ],
}
