{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "northwind-without-apimatic",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true,
  },
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "northwind-without-apimatic",
      // Placeholder: local development and tests only. Replace with the real
      // database_id (from `wrangler d1 create northwind-coffee`) before deploying.
      "database_id": "41bb1bcd-b56d-4edd-9a39-d2e1c6b2612f",
      "migrations_dir": "migrations",
    },
  ],
}
